# Application Configuration
APP_NAME="Analytics and Notification Service"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
API_PREFIX=""

# Database Configuration (PostgreSQL in production, SQLite fallback for dev/testing)
# Example Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/sih_governance
DATABASE_URL="sqlite+aiosqlite:///./governance_analytics.db"

# Redis Configuration (Used for Caching & WebSockets Pub/Sub)
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_REDIS_FALLBACK=True

# SMTP Configuration for Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@governance-platform.org"
SMTP_FROM_NAME="Smart Governance System"
SMTP_USE_TLS=True
SMTP_MOCK_MODE=True

# CORS Settings
CORS_ORIGINS=["*"]
