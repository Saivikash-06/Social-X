FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (required for some python packages like bcrypt and postgres drivers)
RUN apt-get update && apt-get install -y gcc libpq-dev && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt asyncpg

# Copy the entire backend directory
COPY . .

# Set python path so shared modules can be discovered
ENV PYTHONPATH=/app/services/core-service:/app

# Expose the API port
EXPOSE 8000

# Start Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
